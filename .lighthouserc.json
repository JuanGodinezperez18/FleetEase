{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000",
        "http://localhost:3000/dashboard",
        "http://localhost:3000/dashboard/clients",
        "http://localhost:3000/dashboard/vehicles",
        "http://localhost:3000/dashboard/finanzas"
      ],
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless"
      },
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": "warn",
        "categories:accessibility": "error",
        "categories:best-practices": "warn",
        "categories:seo": "warn",
        "first-contentful-paint": "warn",
        "largest-contentful-paint": "warn",
        "cumulative-layout-shift": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
