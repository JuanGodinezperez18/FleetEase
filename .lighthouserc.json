{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000",
        "http://localhost:3000/soluciones",
        "http://localhost:3000/funciones",
        "http://localhost:3000/software-para-flotillas",
        "http://localhost:3000/software-para-renta-de-vehiculos",
        "http://localhost:3000/control-de-mantenimiento-de-flotillas"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": "warn",
        "categories:accessibility": "error",
        "categories:best-practices": "warn",
        "categories:seo": "warn",
        "first-contentful-paint": "warn",
        "largest-contentful-paint": "warn",
        "cumulative-layout-shift": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
