rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== FUNCIONES DE UTILIDAD ==========
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth.token.role == 'superAdmin';
    }

    function isAdmin(companyId) {
      return request.auth.token.role == 'admin' && request.auth.token.companyId == companyId;
    }
    
    function isEditor(companyId) {
      return request.auth.token.role == 'editor' && request.auth.token.companyId == companyId;
    }

    function canWrite(companyId) {
        return isSuperAdmin() || isAdmin(companyId) || isEditor(companyId);
    }
    
    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    function isMemberOfCompany(companyId) {
        return request.auth.token.companyId == companyId;
    }

    // ========== USUARIOS ==========
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow update: if (isOwner(userId) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId', 'partnerAccess', 'isDeleted'])))
                     || isSuperAdmin();
      allow create, delete: if isSuperAdmin();
    }

    // ========== EMPRESAS ==========
    match /companies/{companyId} {
      allow read, write: if isSuperAdmin();
    }
    
    // ========== VEHÍCULOS ==========
    match /vehicles/{vehicleId} {
        allow read: if isSuperAdmin() 
                       || isMemberOfCompany(resource.data.companyId)
                       || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
        allow write: if canWrite(resource.data.companyId);
        allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== CLIENTES ==========
    match /clients/{clientId} {
      allow read: if isSuperAdmin() 
                     || isMemberOfCompany(resource.data.companyId)
                     || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
      allow write: if canWrite(resource.data.companyId);
      allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== SOCIOS ==========
    match /partners/{partnerId} {
      allow read: if isSuperAdmin() 
                     || isMemberOfCompany(resource.data.companyId)
                     || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
      allow write: if canWrite(resource.data.companyId);
      allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== CRÉDITOS ==========
    match /credits/{creditId} {
      allow read: if isSuperAdmin() 
                     || isMemberOfCompany(resource.data.companyId)
                     || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
      allow write: if canWrite(resource.data.companyId);
      allow create: if canWrite(request.resource.data.companyId);
    }
    
    // ========== CRONOGRAMA DE PAGOS ==========
    match /creditPaymentSchedules/{scheduleId} {
      allow read: if isSuperAdmin() 
                     || isMemberOfCompany(resource.data.companyId)
                     || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
      allow write: if canWrite(resource.data.companyId);
      allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== REGISTROS FINANCIEROS ==========
    match /financialRecords/{recordId} {
      allow read: if isSuperAdmin() 
                     || isMemberOfCompany(resource.data.companyId)
                     || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
      allow write: if canWrite(resource.data.companyId);
      allow create: if canWrite(request.resource.data.companyId);
    }
    
    // ========== CATEGORÍAS FINANCIERAS ==========
    match /financialCategories/{categoryId} {
      // ✅ LECTURA: 
      // - Categorías del sistema (companyId == null O isDefault == true): TODOS los usuarios autenticados
      // - Categorías de empresa: miembros de esa empresa, admin, editor, o superAdmin
      allow read: if request.auth != null &&
                     (
                       // Categorías del sistema (null o default)
                       resource.data.get('companyId', null) == null ||
                       resource.data.get('isDefault', false) == true ||
                       // Categorías de empresa
                       isMemberOfCompany(resource.data.companyId) ||
                       request.auth.token.role in ['admin', 'editor', 'superAdmin']
                     );
      
      // ✅ CREACIÓN: 
      // - Categorías del sistema (companyId == null): solo superAdmin
      // - Categorías de empresa: admin, editor, o superAdmin de esa empresa
      allow create: if request.auth != null &&
                      ((request.resource.data.companyId == null &&
                        request.auth.token.role == 'superAdmin') ||
                       (request.resource.data.companyId != null &&
                        canWrite(request.resource.data.companyId)));
      
      // ✅ ACTUALIZACIÓN Y ELIMINACIÓN:
      // - Categorías del sistema: solo superAdmin
      // - Categorías de empresa: admin, editor, o superAdmin de esa empresa
      allow update, delete: if isSuperAdmin() ||
                              ((resource.data.get('companyId', null) == null || 
                                resource.data.get('isDefault', false) == true) && 
                               isSuperAdmin()) ||
                              (resource.data.companyId != null &&
                               canWrite(resource.data.companyId));
    }
    
    // ========== NOTIFICACIONES ==========
    match /notifications/{notificationId} {
        allow read: if isOwner(resource.data.userId) ||
                       isMemberOfCompany(resource.data.companyId) ||
                       isSuperAdmin() ||
                       (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
        allow write, delete: if canWrite(resource.data.companyId);
        allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== REGISTROS DE KILOMETRAJE ==========
    match /mileageLogs/{logId} {
        allow read: if isSuperAdmin() 
                       || isMemberOfCompany(resource.data.companyId)
                       || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
        allow write, delete: if canWrite(resource.data.companyId);
        allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== REGISTROS DE ASIGNACIÓN DE VEHÍCULOS ==========
    match /vehicleAssignmentLogs/{logId} {
        allow read: if isSuperAdmin() 
                       || isMemberOfCompany(resource.data.companyId)
                       || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
        allow write: if canWrite(resource.data.companyId);
        allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== PLANTILLAS DE MENSAJE ==========
    match /messageTemplates/{templateId} {
      allow read: if isSuperAdmin() 
                     || isMemberOfCompany(resource.data.companyId)
                     || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
      allow write: if canWrite(resource.data.companyId);
      allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== INSPECCIONES DE VEHÍCULOS ==========
    match /vehicleInspections/{inspectionId} {
      allow read: if isSuperAdmin() 
                     || isMemberOfCompany(resource.data.companyId)
                     || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
      allow write: if canWrite(resource.data.companyId);
      allow create: if canWrite(request.resource.data.companyId);
      allow delete: if canWrite(resource.data.companyId);
    }

    // ========== REGISTROS DE AUDITORÍA ==========
    match /auditLogs/{logId} {
        allow read: if isSuperAdmin() || isAdmin(resource.data.companyId);
        allow write: if false; // Solo se crean, no se editan ni eliminan
        allow create: if canWrite(request.resource.data.companyId);
    }

    match /clientChangeLogs/{logId} {
        allow read: if isSuperAdmin() 
                       || isMemberOfCompany(resource.data.companyId)
                       || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
        allow write: if false; // Inmutable
        allow create: if isSignedIn();
    }

    match /companyChangeLogs/{logId} {
        allow read: if isSuperAdmin();
        allow write: if false; // Inmutable
        allow create: if isSuperAdmin();
    }

    match /userAuditLogs/{logId} {
        allow read: if isOwner(resource.data.userId) || isSuperAdmin();
        allow write: if false; // Inmutable
        allow create: if isSuperAdmin();
    }

    match /messageLogs/{logId} {
        allow read: if isSuperAdmin() 
                       || isMemberOfCompany(resource.data.companyId)
                       || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
        allow write: if false; // Inmutable
        allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== DASHBOARD PERSONALIZADO ==========
    match /userDashboards/{userId} {
      // El dueño puede leer/escribir su propio dashboard
      allow read, write: if isOwner(userId);
      // SuperAdmin puede leer todos los dashboards
      allow read: if isSuperAdmin();
      // Admin y Editor pueden leer dashboards de usuarios de su misma compañía
      // Nota: Verificamos que el token tenga companyId y que coincida con el rol
      allow read: if request.auth.token.role in ['admin', 'editor'] && 
                     request.auth.token.companyId != null;
    }

    // ========== MULTAS ==========
    match /multas/{multaId} {
      allow read: if isSignedIn() && 
                     (isMemberOfCompany(resource.data.companyId) ||
                      request.auth.token.role == 'admin');
      allow write: if canWrite(resource.data.companyId);
      allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== REPORTES GENERADOS ==========
    match /generatedReports/{reportId} {
      allow read: if isSuperAdmin() 
                     || isMemberOfCompany(resource.data.companyId)
                     || (request.auth.token.role == 'admin' && request.auth.token.companyId != null);
      allow write: if canWrite(resource.data.companyId);
      allow create: if canWrite(request.resource.data.companyId);
    }

    // ========== CATCH-ALL (DEFAULT: DENEGAR TODO) ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
