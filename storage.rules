
rules_version = '2';

// Default service is firebase.storage
service firebase.storage {
  // The {bucket} wildcard indicates we match any bucket in the project
  match /b/{bucket}/o {

    // Helper function to check for authenticated users
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to validate folder names
    function isValidFolder(folder) {
      return folder in ['vehicle_images', 'driver_documents', 'financial_receipts', 'general_documents', 'contract_templates', 'vehicle_inspections'];
    }

    // SECURITY: NO permitir lectura global - cada carpeta define sus permisos
    match /{allPaths=**} {
      allow read, write: if false; // Denegar por defecto
    }

    // Restrict write access - CORREGIDO: Solo el dueño o admin puede eliminar
    match /{folder}/{fileName} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                      && isValidFolder(folder)
                      && request.resource.size < 10 * 1024 * 1024 // 10 MB limit
                      && (
                        request.resource.contentType.matches('image/.*') ||
                        request.resource.contentType.matches('application/pdf') ||
                        request.resource.contentType.matches('application/msword') ||
                        request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
                      );

      // SEGURIDAD: Solo el que subió el archivo o un admin puede eliminarlo
      allow delete: if isAuthenticated() &&
                       (resource.metadata.uploadedBy == request.auth.uid ||
                        request.auth.token.role in ['admin', 'superAdmin']);
    }

    // Reglas específicas para inspecciones de vehículos (con subcarpetas por vehículo)
    match /vehicle_inspections/{vehicleId}/{fileName} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                      && request.resource.size < 10 * 1024 * 1024 // 10 MB limit
                      && request.resource.contentType.matches('image/.*');

      // SEGURIDAD: Solo el que subió el archivo o un admin puede eliminarlo
      allow delete: if isAuthenticated() &&
                       (resource.metadata.uploadedBy == request.auth.uid ||
                        request.auth.token.role in ['admin', 'superAdmin']);
    }
  }
}
