{
    "compilerOptions":  {
                            "target":  "es2020",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "allowJs":  true,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "noImplicitAny":  true,
                            "strictNullChecks":  true,
                            "strictFunctionTypes":  true,
                            "strictBindCallApply":  true,
                            "strictPropertyInitialization":  true,
                            "noImplicitThis":  true,
                            "alwaysStrict":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "react-jsx",
                            "incremental":  true,
                            "plugins":  [

                                        ],
                            "paths":  {
                                          "@/*":  [
                                                      "./src/*"
                                                  ]
                                      },
                            "noEmit":  true
                        },
    "include":  [
                    "next-env.d.ts",
                    "**/*.ts",
                    "**/*.tsx",
                    ".next/types/**/*.ts",
                    ".next/dev/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    ".next",
                    "functions"
                ]
}
