# ============================================
# FleetEase Manager - Variables de Entorno
# ============================================
# Copia este archivo a .env.local y completa los valores.
# NUNCA hagas commit de valores reales.

# Supabase Configuration (Required)
# Proyecto: https://qettktslcbjjuyejcpqy.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Clave PÚBLICA en formato nuevo de Supabase (Settings > API Keys > publishable)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Supabase Service Role Key (Server-side only - NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Aliases para scripts Node.js (scripts/ leen SUPABASE_URL/SUPABASE_ANON_KEY)
# NOTA: .env.local no se carga en scripts fuera de Next.js; definir en .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Firebase Admin (servidor - usado en uploads y notificaciones)
# Solo necesario mientras existan rutas /api/upload y /api/notifications
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Google Maps API (para autocompletado de direcciones)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Notificaciones Push (Web Push / VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Seguridad de Endpoints (generar cadenas aleatorias seguras)
# Protege las rutas /api/cron/*
CRON_SECRET=your-cron-secret-random-string
# Protege el endpoint /api/health
HEALTH_CHECK_SECRET=your-secure-random-secret

# URLs de la Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Alias para las Cloud Functions de Stripe
APP_URL=http://localhost:3000
# URL pública de producción (usada en redirects)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Stripe Configuration (requerido para pagos)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE=price_xxx
# Opcional: URL de retorno del portal de facturación
# STRIPE_PORTAL_RETURN_URL=https://tu-dominio.com/settings/billing

# Opcional: Emuladores de Firebase (desarrollo)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Nota de Seguridad:
# - NUNCA commitees este archivo con valores reales
# - CRON_SECRET y HEALTH_CHECK_SECRET deben ser cadenas aleatorias diferentes por entorno
# - STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET y SUPABASE_SERVICE_ROLE_KEY solo en el servidor
# - Las credenciales de Firebase Admin solo son necesarias mientras exista el backend híbrido
