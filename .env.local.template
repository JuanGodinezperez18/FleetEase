# ============================================
# FleetEase Manager - Variables de Entorno
# ============================================

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (Server-side only - NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Health Check Secret (para acceso autenticado al endpoint /api/health)
HEALTH_CHECK_SECRET=your-secure-random-secret

# Stripe Configuration (Required para pagos)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE=price_xxx

# Cron Jobs Secret (protege las rutas /api/cron/*)
CRON_SECRET=your-cron-secret-random-string

# Firebase Admin (para migración, opcional - se puede eliminar después)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Opcional: Configuración de notificaciones
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Opcional: Integración con WhatsApp
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# Opcional: Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App URL (para CORS y redirects de Stripe)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Nota de Seguridad:
# - NUNCA commitees este archivo con valores reales
# - CRON_SECRET debe ser una cadena aleatoria segura diferente para cada entorno
# - STRIPE_SECRET_KEY y STRIPE_WEBHOOK_SECRET solo en el servidor
# - SUPABASE_SERVICE_ROLE_KEY solo debe usarse en el servidor
# - Las claves de Firebase son solo necesarias durante la migración
