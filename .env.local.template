# ============================================
# FleetEase Manager - Variables de Entorno
# ============================================
# Copia este archivo a .env.local y completa los valores.
# NUNCA hagas commit de valores reales.

# Supabase Configuration (Required)
# Proyecto: https://qettktslcbjjuyejcpqy.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Clave PÚBLICA en formato nuevo de Supabase (Settings > API Keys > publishable)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Supabase Service Role Key (Server-side only - NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Aliases para scripts Node.js (scripts/ leen SUPABASE_URL/SUPABASE_ANON_KEY)
# NOTA: .env.local no se carga en scripts fuera de Next.js; definir en .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Google Maps API (para autocompletado de direcciones)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# reCAPTCHA v2 para proteger el registro público
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Notificaciones Push (Web Push / VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Rate limit distribuido en producción (crear una DB Redis en Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Seguridad de Endpoints (generar cadenas aleatorias seguras)
CRON_SECRET=your-cron-secret-random-string
HEALTH_CHECK_SECRET=your-secure-random-secret

# Operación administrativa de la empresa interna (solo servidor)
INTERNAL_COMPANY_ID=
INTERNAL_COMPANY_NAME=
INTERNAL_ENTERPRISE_CONFIRMATION=

# URLs de la Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Stripe Configuration (requerido para pagos)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_ID_STARTER_MONTHLY=price_xxx
STRIPE_PRICE_ID_STARTER_YEARLY=price_xxx
STRIPE_PRICE_ID_PRO_MONTHLY=price_xxx
STRIPE_PRICE_ID_PRO_YEARLY=price_xxx
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=price_xxx
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=price_xxx

# Resend - correo transaccional de vencimientos y avisos
# Crea la cuenta en Resend y añade la API key como variable de entorno en Vercel.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remitente verificado en Resend, por ejemplo: FleetEase <noreply@tu-dominio.com>
RESEND_FROM_EMAIL=FleetEase <noreply@tu-dominio.com>

# Nota de Seguridad:
# - NUNCA commitees este archivo con valores reales
# - CRON_SECRET y HEALTH_CHECK_SECRET deben ser cadenas aleatorias diferentes por entorno
# - STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY y RESEND_API_KEY solo en el servidor
