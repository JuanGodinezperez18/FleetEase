# ======================
# FLEETEASE MANAGER - VARIABLES DE ENTORNO
# ======================
# Copia este archivo a .env.local y completa los valores
# NUNCA hagas commit de .env.local al repositorio

# ======================
# FIREBASE CLIENT (PUBLIC)
# ======================
# Estos valores son seguros para exponer en el cliente
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fleetease-manager
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ======================
# FIREBASE ADMIN (SERVER - PRIVATE)
# ======================
# ⚠️ NUNCA exponer estos valores en el cliente
# Se obtienen de Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# ======================
# FIREBASE CLOUD MESSAGING (VAPID)
# ======================
# Para notificaciones push web
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ======================
# GOOGLE MAPS
# ======================
# Requerido para mapas y geolocalización
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ======================
# DESARROLLO (OPCIONAL)
# ======================
# Bypass de session cookie para desarrollo local
NEXT_PUBLIC_BYPASS_SESSION_COOKIE=false

# Usar emuladores de Firebase
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Nivel de logging (debug, info, warn, error)
NEXT_PUBLIC_LOG_LEVEL=debug

# ======================
# PRODUCCIÓN
# ======================
# URL de producción para redirecciones
NEXT_PUBLIC_SITE_URL=https://fleetease-manager.web.app

# ======================
# UPLOADS
# ======================
# Límite de tamaño para uploads (en bytes)
NEXT_PUBLIC_MAX_UPLOAD_SIZE=10485760

# ======================
# PAGINACIÓN
# ======================
# Número de elementos por página
NEXT_PUBLIC_PAGE_SIZE=20

# ======================
# CACHE
# ======================
# Tiempo de caché para queries de Firestore (en ms)
NEXT_PUBLIC_FIRESTORE_CACHE_TIME=300000

# ======================
# STRIPE (PAGOS Y SUSCRIPCIONES)
# ======================
# Requerido para gestión de planes y pagos
# Obtén tus claves en: https://dashboard.stripe.com/apikeys

# Stripe Publishable Key (PUBLICA - segura para cliente)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Secret Key (PRIVADA - solo servidor)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Secret (PRIVADA - para verificar webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs para cada plan
# Crea los productos y precios en Stripe Dashboard
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE=price_...

# URL de la aplicación (para redirecciones de Stripe)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ======================
# NOTES
# ======================
# 1. Para obtener las credenciales de Firebase Admin:
#    - Ve a Firebase Console
#    - Project Settings > Service Accounts
#    - Generate New Private Key
#    - Guarda el JSON y copia los valores aquí
#
# 2. Para Google Maps API Key:
#    - Ve a Google Cloud Console
#    - APIs & Services > Credentials
#    - Create Credentials > API Key
#    - Habilita: Maps JavaScript API, Places API, Geocoding API
#
# 3. Para Firebase VAPID Key:
#    - Firebase Console > Project Settings > Cloud Messaging
#    - Web Push certificates > Generate Key Pair
#
# 4. Para Stripe:
#    - Crea una cuenta en https://stripe.com
#    - Obten tus API keys del Dashboard
#    - Crea 3 productos (Starter, Pro, Enterprise) con sus precios
#    - Copia los Price IDs en las variables NEXT_PUBLIC_STRIPE_PRICE_ID_*
#    - Configura el webhook endpoint en Stripe Dashboard:
#      Endpoint: https://tu-dominio/functions/checkout
#      Eventos: checkout.session.completed, customer.subscription.updated
#
# 5. Variables de Cloud Functions:
#    - Para desplegar las funciones con Stripe, ejecuta:
#      firebase functions:secrets:set STRIPE_SECRET_KEY
#      firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#      firebase functions:secrets:set APP_URL
#      firebase functions:secrets:set STRIPE_PRICE_ID_STARTER
#      firebase functions:secrets:set STRIPE_PRICE_ID_PRO
#      firebase functions:secrets:set STRIPE_PRICE_ID_ENTERPRISE
